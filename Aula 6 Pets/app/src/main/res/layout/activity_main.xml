<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/Bege"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/Titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FECAP PET!"
        android:textSize="22dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/Caes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Cães"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Titulo" />

    <ImageView
        android:id="@+id/cachorro1"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toStartOf="@id/cachorro1"
        app:layout_constraintHorizontal_bias="0.01"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Caes"
        app:srcCompat="@drawable/cachorro1" />

    <Button
        android:id="@+id/btnCachorro1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalhes"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="@id/cachorro1"
        app:layout_constraintEnd_toEndOf="@id/cachorro1"
        app:layout_constraintTop_toBottomOf="@id/cachorro1" />

    <ImageView
        android:id="@+id/cachorro2"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        app:srcCompat="@drawable/cachorro2"
        app:layout_constraintStart_toEndOf="@id/cachorro1"
        app:layout_constraintEnd_toStartOf="@id/cachorro3"
        app:layout_constraintTop_toBottomOf="@id/Caes" />

    <Button
        android:id="@+id/btnCachorro2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalhes"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="@id/cachorro2"
        app:layout_constraintEnd_toEndOf="@id/cachorro2"
        app:layout_constraintTop_toBottomOf="@id/cachorro2" />


    <ImageView
        android:id="@+id/cachorro3"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        app:srcCompat="@drawable/cachorro3"
        app:layout_constraintStart_toEndOf="@id/cachorro2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Caes" />

    <Button
        android:id="@+id/btnCachorro3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalhes"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="@id/cachorro3"
        app:layout_constraintEnd_toEndOf="@id/cachorro3"
        app:layout_constraintTop_toBottomOf="@id/cachorro3" />

    <TextView
        android:id="@+id/Gatos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Gatos"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCachorro1" />


    <ImageView
        android:id="@+id/gato1"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:layout_marginTop="12dp"
        app:srcCompat="@drawable/gato1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/gato2"
        app:layout_constraintTop_toBottomOf="@id/Gatos" />

    <Button
        android:id="@+id/btnGato1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalhes"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="@id/gato1"
        app:layout_constraintEnd_toEndOf="@id/gato1"
        app:layout_constraintTop_toBottomOf="@id/gato1" />


    <ImageView
        android:id="@+id/gato2"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        app:srcCompat="@drawable/gato2"
        app:layout_constraintStart_toEndOf="@id/gato1"
        app:layout_constraintEnd_toStartOf="@id/gato3"
        app:layout_constraintTop_toBottomOf="@id/Gatos" />

    <Button
        android:id="@+id/btnGato2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalhes"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="@id/gato2"
        app:layout_constraintEnd_toEndOf="@id/gato2"
        app:layout_constraintTop_toBottomOf="@id/gato2" />


    <ImageView
        android:id="@+id/gato3"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        app:srcCompat="@drawable/gato3"
        app:layout_constraintStart_toEndOf="@id/gato2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Gatos" />

    <Button
        android:id="@+id/btnGato3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalhes"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="@id/gato3"
        app:layout_constraintEnd_toEndOf="@id/gato3"
        app:layout_constraintTop_toBottomOf="@id/gato3" />


</androidx.constraintlayout.widget.ConstraintLayout>