<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green"
    android:padding="24dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/one"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Livraria FECAP"
        android:layout_marginTop="30dp"
        android:textSize="28dp"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/book1"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_marginTop="80dp"
        app:srcCompat="@drawable/book1"
        app:layout_constraintEnd_toStartOf="@id/book2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/one" />

    <ImageView
        android:id="@+id/book2"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_marginTop="80dp"
        app:srcCompat="@drawable/book2"
        app:layout_constraintEnd_toStartOf="@id/book3"
        app:layout_constraintStart_toEndOf="@id/book1"
        app:layout_constraintTop_toTopOf="@id/one" />

    <ImageView
        android:id="@+id/book3"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_marginTop="80dp"
        app:srcCompat="@drawable/book3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/book2"
        app:layout_constraintTop_toTopOf="@id/one" />


</androidx.constraintlayout.widget.ConstraintLayout>