<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="#D1D1D1"
    >

    <TextView
        android:id="@+id/textoHead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="130dp"
        android:text="Bem-vindo ao meu app!"
        android:textSize="30dp"
        android:textColor="#0F307D"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
         />

    <ImageView
        android:id="@+id/fecapLogo"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/textoHead"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:srcCompat="@drawable/fecap" />

    <EditText
        android:id="@+id/inputSenha"
        android:layout_width="280dp"
        android:layout_height="42dp"
        android:hint=" Digite sua senha aqui"
        android:inputType="text"
        android:maxLength="8"
        android:layout_marginTop="20dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/fecapLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/botao"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="Confirmar"
        android:layout_marginTop="20dp"
        app:cornerRadius="20dp"
        app:layout_constraintTop_toBottomOf="@id/inputSenha"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:backgroundTint="#0F307D" />

    <TextView
        android:id="@+id/textoBaixo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Siga-nos nas redes sociais"
        android:layout_marginBottom="100dp"
        android:textSize="16dp"
        android:textColor="#000000"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <ImageView
        android:id="@+id/logo1"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:srcCompat="@drawable/logo1"
        app:layout_constraintTop_toBottomOf="@id/textoBaixo"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/logo2"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toStartOf="@+id/textoBaixo"
        app:layout_constraintTop_toBottomOf="@id/textoBaixo"
        app:srcCompat="@drawable/logo2" />

    <ImageView
        android:id="@+id/logo3"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toEndOf="@+id/textoBaixo"
        app:layout_constraintTop_toBottomOf="@id/textoBaixo"
        app:srcCompat="@drawable/logo3" />


</androidx.constraintlayout.widget.ConstraintLayout>