<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="15dp"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/textViewpet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="FECAP PET!"
        android:textColor="@color/black"
        android:textSize="35dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewcao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:fontFamily="cursive"
        android:text="Cães"
        android:textColor="@color/black"
        android:textSize="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewcao"/>

    <ImageView
        android:id="@+id/cao1"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/textViewcao"
        app:srcCompat="@drawable/cao1" />

    <Button
        android:id="@+id/button1"
        android:layout_width="117dp"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="Detalhes"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:backgroundTint="@color/purple"
        app:layout_constraintTop_toBottomOf="@id/cao1"
        app:layout_constraintStart_toStartOf="@id/cao1"
        app:layout_constraintEnd_toEndOf="@id/cao1" />

    <ImageView
        android:id="@+id/cao2"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@id/cao3"
        app:layout_constraintStart_toEndOf="@id/cao1"
        app:layout_constraintTop_toBottomOf="@id/textViewcao"
        app:srcCompat="@drawable/cao2" />

    <Button
        android:id="@+id/button2"
        android:layout_width="117dp"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="Detalhes"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:backgroundTint="@color/purple"
        app:layout_constraintTop_toBottomOf="@id/cao2"
        app:layout_constraintStart_toStartOf="@id/cao2"
        app:layout_constraintEnd_toEndOf="@id/cao2" />

    <ImageView
        android:id="@+id/cao3"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@id/cao3"
        app:layout_constraintStart_toEndOf="@id/cao1"
        app:layout_constraintTop_toBottomOf="@id/textViewcao"
        app:srcCompat="@drawable/cao3" />

    <Button
        android:id="@+id/button3"
        android:layout_width="117dp"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="Detalhes"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:backgroundTint="@color/purple"
        app:layout_constraintTop_toBottomOf="@id/cao3"
        app:layout_constraintStart_toStartOf="@id/cao3"
        app:layout_constraintEnd_toEndOf="@id/cao3" />

    <TextView
        android:id="@+id/textViewgato"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:fontFamily="cursive"
        android:text="Gatos"
        android:textColor="@color/black"
        android:textSize="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button2" />

    <ImageView
        android:id="@+id/gato1"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/textViewgato"
        app:srcCompat="@drawable/gato1" />

    <Button
        android:id="@+id/button4"
        android:layout_width="117dp"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="Detalhes"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:backgroundTint="@color/purple"
        app:layout_constraintTop_toBottomOf="@id/gato1"
        app:layout_constraintStart_toStartOf="@id/gato1"
        app:layout_constraintEnd_toEndOf="@id/gato1" />

    <ImageView
        android:id="@+id/gato2"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@id/gato3"
        app:layout_constraintStart_toEndOf="@id/gato1"
        app:layout_constraintTop_toBottomOf="@id/textViewgato"
        app:srcCompat="@drawable/gato2" />

    <Button
        android:id="@+id/button5"
        android:layout_width="117dp"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="Detalhes"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:backgroundTint="@color/purple"
        app:layout_constraintTop_toBottomOf="@id/gato2"
        app:layout_constraintStart_toStartOf="@id/gato2"
        app:layout_constraintEnd_toEndOf="@id/gato2" />

    <ImageView
        android:id="@+id/gato3"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@id/gato3"
        app:layout_constraintStart_toEndOf="@id/gato1"
        app:layout_constraintTop_toBottomOf="@id/textViewgato"
        app:srcCompat="@drawable/gato3" />

    <Button
        android:id="@+id/button6"
        android:layout_width="117dp"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="Detalhes"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:backgroundTint="@color/purple"
        app:layout_constraintTop_toBottomOf="@id/gato3"
        app:layout_constraintStart_toStartOf="@id/gato3"
        app:layout_constraintEnd_toEndOf="@id/gato3" />


</androidx.constraintlayout.widget.ConstraintLayout>