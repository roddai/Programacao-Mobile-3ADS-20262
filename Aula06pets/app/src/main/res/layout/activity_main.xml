<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:padding="30dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5DE"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/text_principal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FECAP PET"
        android:textSize="25dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/main" />

    <TextView
        android:id="@+id/tipo_caes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cães"
        android:textSize="20dp"
        android:textStyle="bold"
        android:layout_margin="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/main" />

    <TextView
        android:id="@+id/tipo_gatos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gatos"
        android:textSize="20dp"
        android:textStyle="bold"
        android:layout_margin="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/button2" />


    <ImageView
        android:id="@+id/cao1"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/cao1"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/tipo_caes"
        app:layout_constraintStart_toStartOf="parent"
        />

    <Button
        android:id="@+id/button1"
        android:layout_width="90dp"
        android:layout_height="40dp"
        android:text="Detalhe"
        android:textSize="11dp"
        app:layout_constraintTop_toBottomOf="@id/cao1"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"
        />

    <ImageView
        android:id="@+id/cao2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/cao2"
        app:layout_constraintTop_toBottomOf="@id/tipo_caes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        />

    <Button
        android:id="@+id/button2"
        android:layout_width="90dp"
        android:layout_height="40dp"
        android:text="Detalhe"
        android:textSize="11dp"
        app:layout_constraintTop_toBottomOf="@id/cao2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"
        />

    <ImageView
        android:id="@+id/cao3"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/cao3"
        app:layout_constraintTop_toBottomOf="@id/tipo_caes"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        />

    <Button
        android:id="@+id/button3"
        android:layout_width="90dp"
        android:layout_height="40dp"
        android:text="Detalhe"
        android:textSize="11dp"
        app:layout_constraintTop_toBottomOf="@id/cao3"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"
        />

    <ImageView
        android:id="@+id/cat1"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/gato1"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/tipo_gatos"
        app:layout_constraintStart_toStartOf="parent"
        />

    <Button
        android:id="@+id/button4"
        android:layout_width="90dp"
        android:layout_height="40dp"
        android:text="Detalhe"
        android:textSize="11dp"
        app:layout_constraintTop_toBottomOf="@id/cat1"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"
        />

    <ImageView
        android:id="@+id/cat2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/gato2"
        app:layout_constraintTop_toBottomOf="@id/tipo_gatos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        />

    <Button
        android:id="@+id/button5"
        android:layout_width="90dp"
        android:layout_height="40dp"
        android:text="Detalhe"
        android:textSize="11dp"
        app:layout_constraintTop_toBottomOf="@id/cat2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"
        />

    <ImageView
        android:id="@+id/cat3"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/gato3"
        app:layout_constraintTop_toBottomOf="@id/tipo_gatos"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        />

    <Button
        android:id="@+id/button6"
        android:layout_width="90dp"
        android:layout_height="40dp"
        android:text="Detalhe"
        android:textSize="11dp"
        app:layout_constraintTop_toBottomOf="@id/cat3"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"
        />












</androidx.constraintlayout.widget.ConstraintLayout>