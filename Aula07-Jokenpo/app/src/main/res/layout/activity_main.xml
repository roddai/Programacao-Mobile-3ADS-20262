<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:padding="40dp"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JoKenPo!"
        android:textSize="50dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgmaquina"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:srcCompat="@drawable/maquina"
        app:layout_constraintEnd_toStartOf="@id/imginte" Of="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titulo"

       />
    <TextView
        android:id="@+id/resultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="resultado!"
        android:textSize="30dp"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgmaquina" />

    <ImageView
        android:id="@+id/imgPedra"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/pedra"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toStartOf="@id/imgPapel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/simbolo"

        />
    <ImageView
        android:id="@+id/imgPapel"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/papel"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toStartOf="@id/imgTesoura"
        app:layout_constraintStart_toEndOf="@id/imgPedra"
        app:layout_constraintTop_toBottomOf="@+id/simbolo"

        />
    <ImageView
        android:id="@+id/imgTesoura"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/tesoura"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imgPapel"
        app:layout_constraintTop_toBottomOf="@+id/simbolo"


        />
    <ImageView
        android:id="@+id/imgusuescolhido"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/pedra"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toStartOf="@id/imginte2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/resultado"/>
    <ImageView
        android:id="@+id/imgfem"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/usuario_fem"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imgmasc"
        app:layout_constraintTop_toBottomOf="@+id/personagem"/>
    <ImageView
        android:id="@+id/imgmasc"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/usuario_masc"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toStartOf="@id/imgfem"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/personagem"/>
    <TextView
        android:id="@+id/simbolo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha um simbolo!"
        android:textSize="30dp"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imginte2" />
    <ImageView
        android:id="@+id/imginte2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/interrogacao"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imgusuescolhido"
        app:layout_constraintTop_toBottomOf="@+id/resultado"/>
    <ImageView
        android:id="@+id/imginte"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/interrogacao"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imgmaquina"
        app:layout_constraintTop_toBottomOf="@+id/titulo"/>
    <TextView
        android:id="@+id/personagem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha seu personagem!"
        android:textSize="20dp"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgPapel" />



</androidx.constraintlayout.widget.ConstraintLayout>