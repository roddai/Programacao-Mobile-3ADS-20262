<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ADIVINHE O PAÍS"
                android:textColor="#007AFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:letterSpacing="0.12"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="28dp" />

            <TextView
                android:id="@+id/txtPergunta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pergunta 1 de 10"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#6E6E73"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtPontuacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pontuação: 0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1D1D1F"
                android:gravity="center"
                android:layout_marginBottom="28dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="De qual país é esta bandeira?"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1D1D1F"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <ImageView
                android:id="@+id/imgBandeira"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:scaleType="fitCenter"
                android:contentDescription="Bandeira do país da pergunta"
                android:layout_marginBottom="28dp" />

            <RadioGroup
                android:id="@+id/grupoRespostas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="28dp">

                <RadioButton
                    android:id="@+id/radioOpcao1"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Alternativa 1"
                    android:textSize="16sp"
                    android:textColor="#1D1D1F"
                    android:buttonTint="#007AFF" />

                <RadioButton
                    android:id="@+id/radioOpcao2"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Alternativa 2"
                    android:textSize="16sp"
                    android:textColor="#1D1D1F"
                    android:buttonTint="#007AFF" />

                <RadioButton
                    android:id="@+id/radioOpcao3"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Alternativa 3"
                    android:textSize="16sp"
                    android:textColor="#1D1D1F"
                    android:buttonTint="#007AFF" />

                <RadioButton
                    android:id="@+id/radioOpcao4"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Alternativa 4"
                    android:textSize="16sp"
                    android:textColor="#1D1D1F"
                    android:buttonTint="#007AFF" />

            </RadioGroup>

            <Button
                android:id="@+id/btnResponder"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Confirmar resposta"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:backgroundTint="#007AFF"
                android:layout_marginBottom="20dp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
