<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FECAP PET"
        android:layout_marginTop="30dp"
        android:textSize="30dp"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/cachorros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cachorros"
        android:layout_marginTop="30dp"
        android:textSize="30dp"
        android:textColor="@color/black"
        app:layout_constraintEnd_toStartOf="@id/memphis"
        app:layout_constraintStart_toEndOf="@id/gabigol"
        app:layout_constraintTop_toBottomOf="@+id/titulo"/>


    <ImageView
        android:id="@+id/gabigol"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:layout_marginTop="100dp"
        app:srcCompat="@drawable/gabicachorro"
        app:layout_constraintEnd_toStartOf="@id/neymar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titulo"/>

    <ImageView
        android:id="@+id/neymar"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:layout_marginTop="100dp"
        app:srcCompat="@drawable/cachorroney"
        app:layout_constraintEnd_toStartOf="@id/memphis"
        app:layout_constraintStart_toEndOf="@id/gabigol"
        app:layout_constraintTop_toBottomOf="@+id/titulo"/>

    <ImageView
        android:id="@+id/memphis"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:layout_marginTop="100dp"
        app:srcCompat="@drawable/cachorrodepay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/neymar"
        app:layout_constraintTop_toBottomOf="@+id/titulo"/>

    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalhes"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toStartOf="@+id/button2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gabigol"/>

    <Button
        android:id="@+id/button2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalhes"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toStartOf="@+id/button3"
        app:layout_constraintStart_toEndOf="@+id/button"
        app:layout_constraintTop_toBottomOf="@+id/neymar"/>

    <Button
        android:id="@+id/button3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalhes"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/button2"
        app:layout_constraintTop_toBottomOf="@+id/memphis"/>

    <TextView
        android:layout_width="109dp"
        android:layout_height="37dp"
        android:layout_marginTop="250dp"
        android:text="Gatos"
        android:textSize="30dp"
        app:layout_constraintEnd_toStartOf="@id/memphis"
        app:layout_constraintStart_toEndOf="@id/gabigol"
        app:layout_constraintTop_toBottomOf="@+id/cachorros" />


    <ImageView
        android:id="@+id/gato1"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:layout_marginTop="100dp"
        app:srcCompat="@drawable/gatobranco"
        app:layout_constraintEnd_toStartOf="@id/neymar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button2"/>

    <ImageView
        android:id="@+id/gato2"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:layout_marginTop="100dp"
        app:srcCompat="@drawable/gatopreto"
        app:layout_constraintEnd_toStartOf="@id/memphis"
        app:layout_constraintStart_toEndOf="@id/gabigol"
        app:layout_constraintTop_toBottomOf="@+id/button"/>

    <ImageView
        android:id="@+id/gato3"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:layout_marginTop="100dp"
        app:srcCompat="@drawable/gatomarrom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/neymar"
        app:layout_constraintTop_toBottomOf="@+id/button3"/>

    <Button
        android:id="@+id/button4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalhes"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toStartOf="@+id/button2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gato1"/>

    <Button
        android:id="@+id/button5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalhes"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toStartOf="@+id/button3"
        app:layout_constraintStart_toEndOf="@+id/button"
        app:layout_constraintTop_toBottomOf="@+id/gato2"/>

    <Button
        android:id="@+id/button6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalhes"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/button2"
        app:layout_constraintTop_toBottomOf="@+id/gato3"/>







</androidx.constraintlayout.widget.ConstraintLayout>