<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Certificados">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cabecalho"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:background="#140D52"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/imglogo"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Certificados próxima Etapa"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/imgLogo"
            app:layout_constraintTop_toTopOf="@id/imgLogo"
            app:layout_constraintBottom_toBottomOf="@id/imgLogo"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rodape"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:background="#F5F5F5"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnInicio"
            android:layout_width="95dp"
            android:layout_height="70dp"
            android:text="inicio"
            android:textSize="12sp"
            android:backgroundTint="#140D52"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnAgenda"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnAgenda"
            android:layout_width="95dp"
            android:layout_height="70dp"
            android:text="Agenda"
            android:textSize="12sp"
            android:backgroundTint="#140D52"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCertificados"
            app:layout_constraintStart_toEndOf="@id/btnInicio"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnCertificados"
            android:layout_width="95dp"
            android:layout_height="70dp"
            android:text="Conquista"
            android:textSize="10sp"
            android:backgroundTint="#140D52"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnPerfil"
            app:layout_constraintStart_toEndOf="@id/btnAgenda"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnPerfil"
            android:layout_width="95dp"
            android:layout_height="70dp"
            android:text="Perfil"
            android:textSize="12sp"
            android:backgroundTint="#140D52"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnCertificados"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollConteudo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/cabecalho"
        app:layout_constraintBottom_toTopOf="@id/rodape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/conteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtNomeAluno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Regina George"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardCertificado1"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@color/white"
                android:elevation="8dp"
                android:padding="16dp"
                app:layout_constraintTop_toBottomOf="@id/txtNomeAluno"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/txtCurso1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRILHA DE CARREIRAS"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/txtInstituicao1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Insper"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/txtCurso1"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/txtHoras1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12h"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/txtInstituicao1"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/txtData1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18/04/2026"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/txtHoras1"
                    app:layout_constraintStart_toEndOf="@id/txtHoras1"/>

                <Button
                    android:id="@+id/btnVisualizar1"
                    android:layout_width="140dp"
                    android:layout_height="60dp"
                    android:text="Visualizar"
                    android:backgroundTint="#140D52"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/txtHoras1"
                    app:layout_constraintStart_toStartOf="parent"/>

                <Button
                    android:id="@+id/btnPdf1"
                    android:layout_width="140dp"
                    android:layout_height="60dp"
                    android:text="Baixar PDF"
                    android:backgroundTint="#140D52"
                    app:layout_constraintTop_toTopOf="@id/btnVisualizar1"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>